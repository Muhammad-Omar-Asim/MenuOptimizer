{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "."
      }
    }
  ],
  "rewrites": [
    {
      "source": "/reviewer",
      "destination": "/reviewer/dist/index.html"
    },
    {
      "source": "/reviewer/(.*)",
      "destination": "/reviewer/dist/$1"
    }
  ]
}
