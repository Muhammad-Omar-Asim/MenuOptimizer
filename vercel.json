{
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    {
      "source": "/reviewer",
      "destination": "/reviewer-app/index.html"
    },
    {
      "source": "/reviewer/",
      "destination": "/reviewer-app/index.html"
    },
    {
      "source": "/reviewer/(.*)",
      "destination": "/reviewer-app/$1"
    }
  ]
}
